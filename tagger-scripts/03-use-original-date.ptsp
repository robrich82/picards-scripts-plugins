title: Use Original Date
script_language_version: '1.1'
script: |
  $set(_o,$get_new(originaldate))
  $set(_d,$get_new(date))
  $if($not($startswith(%_d%,%_o%)),$set(_d,%_o%))
  $if($eq($len(%_o%),4),$set(_o,%_o%-01-01))
  $if($eq($len(%_o%),7),$set(_o,%_o%-01))
  $if($eq($len(%_d%),4),$set(_d,%_d%-01-01))
  $if($eq($len(%_d%),7),$set(_d,%_d%-01))
  $set(originaldate,%_o%)
  $set(date,%_d%)
  $set(originalyear,$left(%date%,4))
  $unset(_o)$unset(_d)
